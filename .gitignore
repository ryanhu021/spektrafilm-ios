# Xcode. The project is generated from App/project.yml by `make project`, so nothing under
# .xcodeproj is tracked: a pbxproj is unreviewable in a diff and conflicts on parallel changes.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Parity oracle, rebuilt on demand by `make oracle`
Tools/parity/oracle/

# Local scratch
*.log

# Generated by XcodeGen from App/project.yml
App/Generated/
